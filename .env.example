# The Nimi Host sets these for the worker. No model keys: the Host executes every AI request.
# Chrome executable; default: the standard Google Chrome install location.
JEV_CHROME_PATH=
# App-owned automation profile, kept between runs; default: a temporary profile removed on close.
JEV_BROWSER_PROFILE_DIR=
# Parent directory for the worker's temporary runtime files; default: the system temp directory.
JEV_RUNTIME_DIR=
# 1 runs the automation Chrome headless.
JEV_CHROME_HEADLESS=
