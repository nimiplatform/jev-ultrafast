{
  "name": "jev-ultrafast",
  "version": "0.1.3",
  "private": true,
  "description": "Jev Ultrafast browser agent adapted as a Nimi desktop App: an Electron Host plus the App-owned Python worker.",
  "author": "Jev Ultrafast contributors",
  "type": "module",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1533 --strictPort",
    "init": "nimi-app init --adopt",
    "sync": "nimi-app sync",
    "check": "nimi-app check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "nimi-app test",
    "test:app": "node scripts/setup-worker.mjs && node scripts/run-tests.mjs",
    "setup:worker": "node scripts/setup-worker.mjs",
    "test:packaged-worker": "node scripts/check-packaged-worker.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-host.mjs",
    "build:worker": "node scripts/setup-worker.mjs && node scripts/build-worker.mjs",
    "build:electron:production": "node scripts/setup-worker.mjs && node scripts/build-production.mjs",
    "app:build": "nimi-app build",
    "pack": "nimi-app pack",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron"
  },
  "dependencies": {
    "@nimiplatform/kit": "^0.22.1",
    "@nimiplatform/sdk": "^0.22.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@nimiplatform/app-tools": "^0.14.0",
    "@nimiplatform/nimi-coding": "0.7.0",
    "@types/node": "^24.13.3",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "yaml": "^2.9.0"
  }
}
